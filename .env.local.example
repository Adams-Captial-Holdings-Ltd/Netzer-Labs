# =====================================================================
# Netzer OS - LOCAL DEVELOPMENT env template
#
# Copy to .env (which is gitignored):
#     cp .env.local.example .env
# or just run `npm run local`, which copies it for you when .env is absent.
#
# Every value here is FAKE and local-only. There are no real secrets in this
# file and none should ever be added to it.
#
# Canonical guide: development.md at the repo root.
#
# Do NOT copy .env.example / .env.reference / .env.staging.example instead:
# all three fail the zod env validation in src/config/env.ts.
# =====================================================================

# ---- Process -------------------------------------------------------
# NEVER set NODE_ENV=production locally: it arms the deployed-task fail-fast
# in src/config/env.ts and the orchestrator will refuse to start.
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# ---- AWS -> Floci emulator -----------------------------------------
# AWS_ENDPOINT_URL is the ONE variable that keeps local development off real
# AWS. Every AWS client in src/ is built with { region } only, so the SDK
# reads this variable and routes every call to the local emulator.
# If you remove it, the SDK silently falls back to real AWS endpoints.
# `npm run local:verify` proves which way you are pointed.
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_REGION=us-east-1

# Deliberately fake credentials. The emulator accepts anything; real AWS
# rejects these, which is the point: if the endpoint override is ever lost,
# calls fail with an auth error instead of succeeding against a real account.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# The account id every emulator reports. The isolation guard asserts on it.
AWS_ACCOUNT_ID=000000000000

# ---- Dashboard login ------------------------------------------------
# Local auth is a bearer token. Paste this value into the dashboard login
# screen under "Advanced". Fake, local-only, safe to commit in this template.
DASHBOARD_TOKEN=local-dev-dashboard-token
CCE_DASHBOARD_URL=http://localhost:5173

# ---- Bedrock --------------------------------------------------------
# At least one model id must be set or the agent loop throws
# "No Bedrock model configured". Locally this only names the model: Floci
# answers with stub text and never calls a real model. See development.md,
# "Known local limitations".
BEDROCK_DEFAULT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# ---- Buckets --------------------------------------------------------
# Created by `npm run local:provision`. Names are free-form; src/ never
# derives them, so these must match what the provisioner creates.
CONFIG_BUCKET=claudeclaw-config
RAW_BUCKET=claudeclaw-raw
CURATED_BUCKET=claudeclaw-curated
VECTORS_BUCKET=claudeclaw-vectors-staging
# AUDIT_LOCK_BUCKET is intentionally UNSET. It needs S3 Object Lock, which the
# emulator does not reproduce; the audit writer no-ops cleanly when it is unset.

# ---- Tables ---------------------------------------------------------
# Intentionally no TABLE_* variables. Every repo in src/ falls back to the
# unsuffixed `claudeclaw-*` literal, which is exactly what the provisioner
# creates, so local and deployed code take the same path.
# Do NOT set CCE_NAME_SUFFIX locally: four modules read the unsuffixed name
# regardless and would look for tables that do not exist.

CCE_TASK_ROLE_NAME=claudeclaw-task-role

# ---- Background loops ----------------------------------------------
# Off by default so a local boot is quiet and deterministic.
# To exercise scheduled tasks, comment out CCE_SCHEDULER_DISABLED and set:
#     CCE_USE_IN_PROCESS_SCHEDULER=1
#     CCE_SCHEDULER_TICK_SEC=10
CCE_SCHEDULER_DISABLED=1
CCE_WEBHOOK_MONITOR_DISABLED=1
# Transcribe answers locally but writes its output to a bucket that does not
# exist, so voice-note transcription always fails. Off by default.
CCE_TRANSCRIBE_DISABLED=1

# ---- Optional extras ------------------------------------------------
# Config-invalidation fanout across processes (topic is provisioned for you).
# Enabling it makes the orchestrator create and tear down an ephemeral SQS
# queue on each boot/shutdown.
# CCE_CONFIG_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:claudeclaw-config-invalidation
#
# Jarvis voice co-pilot admission chain (the live Nova Sonic stream itself
# cannot run locally; see development.md).
# JARVIS_LAUNCH_ENABLED=true
#
# Skip the outbound api.github.com update check in `npm run doctor`.
# CCE_UPDATE_CHECK_DISABLED=1

# ---- Deliberately absent --------------------------------------------
# No Slack, Telegram, Salesforce, or vendor API keys. Local development does
# not talk to third-party services. Add them only if you are deliberately
# testing that integration, and never commit the result.
