{
  "name": "enterpriseos",
  "version": "0.0.1",
  "description": "EnterpriseOS by Netzer Labs: enterprise AI agent infrastructure for customer-controlled AWS environments.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pack": "tsx scripts/pack.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:integration:down": "docker compose -f docker-compose.test.yml down -v",
    "test:integration:all": "npm run test:integration:up && npm run test:integration && npm run test:integration:down",
    "test:paperclip:up": "docker compose -f docker-compose.paperclip.yml up -d --wait --build",
    "test:paperclip:down": "docker compose -f docker-compose.paperclip.yml down -v",
    "test:paperclip:all": "npm run test:paperclip:up && npm run test:integration && npm run test:paperclip:down",
    "test:paperclip:contract": "node -e \"if (!process.env.PAPERCLIP_TEST_AUTH_SECRET) { console.error('PAPERCLIP_TEST_AUTH_SECRET is required'); process.exit(1) }\" && vitest run --config vitest.integration.config.ts tests/contract/paperclip",
    "e2e:chat": "playwright test --config tests/e2e/chat/playwright.config.ts",
    "local": "node scripts/local/dev.mjs",
    "local:up": "docker compose -f docker-compose.local.yml up -d --wait",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "local:reset": "docker compose -f docker-compose.local.yml down && docker compose -f docker-compose.local.yml up -d --wait && tsx --env-file=.env scripts/local/provision.ts && tsx --env-file=.env scripts/seed.ts",
    "local:logs": "docker compose -f docker-compose.local.yml logs -f floci",
    "local:provision": "tsx --env-file=.env scripts/local/provision.ts",
    "local:verify": "tsx --env-file=.env scripts/local/guard.ts",
    "local:test:integration": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "up": "node scripts/up-launcher.mjs",
    "setup": "tsx scripts/setup.ts",
    "status": "tsx scripts/status.ts",
    "doctor": "tsx scripts/doctor.ts",
    "early-win": "tsx scripts/early-win.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "power:setup": "tsx scripts/power-setup.ts",
    "destroy": "tsx scripts/destroy.ts",
    "validate:tier1": "tsx scripts/tier1-validate.ts",
    "verify:boundary": "tsx scripts/verify-boundary.ts",
    "seed": "tsx scripts/seed.ts",
    "demo:seed": "tsx scripts/demo/seed.ts",
    "demo:reset": "tsx scripts/demo/reset.ts",
    "verify": "tsx scripts/status.ts --strict",
    "teardown": "tsx scripts/teardown.ts",
    "update": "tsx scripts/update.ts",
    "handover": "tsx scripts/handover.ts",
    "support-bundle": "tsx scripts/support-bundle.ts",
    "dashboard:tunnel": "tsx scripts/dashboard-tunnel.ts",
    "warp:setup": "tsx scripts/warp-setup.ts",
    "paperclip:bootstrap": "tsx scripts/paperclip-bootstrap.ts",
    "paperclip:shadow": "tsx scripts/paperclip-shadow.ts",
    "public:setup": "tsx scripts/public-setup.ts",
    "email:setup": "tsx scripts/email-setup.ts",
    "deploy": "tsx scripts/deploy.ts",
    "deploy:cloud": "aws codebuild start-build --project-name claudeclaw-orchestrator-deploy --region us-east-1",
    "deploy:rollback": "tsx scripts/rollback.ts",
    "restore:ddb": "tsx scripts/restore-ddb.ts",
    "mission": "tsx scripts/mission.ts",
    "schedule:cli": "tsx scripts/schedule.ts",
    "audit-query": "tsx scripts/audit-query.ts",
    "battle": "tsx scripts/battle.ts",
    "loadtest": "k6 run tests/load/test-turn.js",
    "synth": "cdk synth",
    "cdk": "cdk"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-accessanalyzer": "^3.1148.0",
    "@aws-sdk/client-bedrock": "^3.1148.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1148.0",
    "@aws-sdk/client-budgets": "^3.1148.0",
    "@aws-sdk/client-cloudformation": "^3.1148.0",
    "@aws-sdk/client-cloudtrail": "^3.1148.0",
    "@aws-sdk/client-cloudwatch": "^3.1148.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1148.0",
    "@aws-sdk/client-cost-explorer": "^3.1148.0",
    "@aws-sdk/client-dynamodb": "^3.1148.0",
    "@aws-sdk/client-ec2": "^3.1148.0",
    "@aws-sdk/client-ecs": "^3.1148.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1148.0",
    "@aws-sdk/client-eventbridge": "^3.1148.0",
    "@aws-sdk/client-guardduty": "^3.1148.0",
    "@aws-sdk/client-iam": "^3.1148.0",
    "@aws-sdk/client-kms": "^3.1148.0",
    "@aws-sdk/client-lambda": "^3.1148.0",
    "@aws-sdk/client-polly": "^3.1148.0",
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/client-scheduler": "^3.1148.0",
    "@aws-sdk/client-secrets-manager": "^3.1148.0",
    "@aws-sdk/client-sesv2": "^3.1148.0",
    "@aws-sdk/client-sns": "^3.1148.0",
    "@aws-sdk/client-sqs": "^3.1148.0",
    "@aws-sdk/client-sts": "^3.1148.0",
    "@aws-sdk/client-transcribe": "^3.1148.0",
    "@aws-sdk/client-wafv2": "^3.1148.0",
    "@aws-sdk/credential-provider-node": "^3.972.54",
    "@aws-sdk/lib-dynamodb": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@hono/node-server": "^1.13.7",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.4.6",
    "aws-xray-sdk-core": "^3.12.0",
    "docx": "^9.9.0",
    "exceljs": "^4.4.0",
    "hono": "^4.13.13",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pino": "^9.5.0",
    "pptxgenjs": "^4.0.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/ws": "^8.18.2",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "aws-cdk-lib": {
      "jsonschema": "1.4.1"
    }
  }
}
