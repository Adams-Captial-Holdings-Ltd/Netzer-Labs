# =====================================================================
# Netzar OS Enterprise · .env template
# Copy to .env and fill in. .env is gitignored.
# =====================================================================

# ── AWS context (populated by `npm run setup`) ────────────────────────
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1

# ── Bedrock ───────────────────────────────────────────────────────────
# Cross-region inference profile IDs. Resolve at deploy time via
# `aws bedrock list-inference-profiles` rather than hardcoding.
BEDROCK_DEFAULT_MODEL=
BEDROCK_OPUS_MODEL=
BEDROCK_SONNET_MODEL=
BEDROCK_HAIKU_MODEL=
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ── Deploy targets ────────────────────────────────────────────────────
CDK_STACK_NAME=ClaudeClawEnterprise
ECR_REPO_NAME=claudeclaw-enterprise
DEPLOY_TIER=1
DEPLOY_MANIFEST_BUCKET=

# ── Surfaces ──────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# Telegram tokens (one per agent). Comma-separated agent:token pairs
# in TELEGRAM_TOKENS_JSON, or single TELEGRAM_BOT_TOKEN_MAIN for fan-out.
TELEGRAM_TOKENS_JSON=
TELEGRAM_WEBHOOK_SECRET=

# ── HTTPS / public hostname ───────────────────────────────────────────
# If you have a domain in Route 53, set DOMAIN_NAME and CDK will:
#   - Issue an ACM cert via DNS validation
#   - Add an A record (alias) for the FQDN to the ALB
#   - Configure HTTPS:443 listener + HTTP:80 redirect
# If you have a cert ARN already, set ACM_CERT_ARN and manage DNS yourself.
# Leave both blank for HTTP-only (dev/test only; Slack/Telegram will reject).
DOMAIN_NAME=
ACM_CERT_ARN=

# Delegated-subzone override: when the apex domain is NOT in this account's
# Route 53 (e.g. apex at Cloudflare, only a subdomain delegated here), set
# both so CDK references the delegated zone directly instead of the failing
# apex lookup. Leave blank when the apex zone lives in Route 53.
HOSTED_ZONE_ID=
HOSTED_ZONE_NAME=

# ── Dashboard ─────────────────────────────────────────────────────────
DASHBOARD_TOKEN=
DASHBOARD_PORT=3000

# Email sign-in (magic links) is OPTIONAL and inert until BOTH are set and
# forwarded by a deploy: CCE_EMAIL_FROM must be an SES-verified identity
# (plus SES production access for arbitrary recipients), CCE_DASHBOARD_URL
# is the URL links point at. The bearer DASHBOARD_TOKEN is the initial way
# in; users receive links only after an admin invites them.
CCE_EMAIL_FROM=
CCE_DASHBOARD_URL=
CCE_SES_CONFIG_SET=

# ── Security ──────────────────────────────────────────────────────────
SECURITY_PIN_HASH=
EMERGENCY_KILL_PHRASE=
APP_ENCRYPTION_KEY=

# ── Runtime ───────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
CONFIG_CACHE_TTL_SECONDS=300

# ── Storage (set by CDK outputs after first deploy) ──────────────────
CONFIG_BUCKET=
RAW_BUCKET=
CURATED_BUCKET=
VECTORS_STAGING_BUCKET=
LOGS_BUCKET=

# ── DynamoDB tables (set by CDK outputs) ─────────────────────────────
TABLE_SESSIONS=
TABLE_HIVE_MIND=
TABLE_AUDIT_LOG=
TABLE_CHAT_CONFIG=
TABLE_TOKEN_USAGE=
TABLE_MEMORIES=
TABLE_CONSOLIDATIONS=
TABLE_AGENT_FILE_HISTORY=
TABLE_MISSION_TASKS=
TABLE_SCHEDULED_TASKS=
TABLE_KILL_SWITCHES=
TABLE_INTER_AGENT_TASKS=
TABLE_COMPACTION_EVENTS=
TABLE_QUEUE_LEASE=
TABLE_SPEND_LEDGER=

# ── Messaging (set by CDK outputs) ───────────────────────────────────
CONFIG_INVALIDATION_TOPIC_ARN=
CONFIG_INVALIDATION_QUEUE_URL=
INGEST_QUEUE_URL=

# ── Outbound PII policy on web_search (B3) ───────────────────────────
# `refuse` blocks any web_search call whose query matches a PII pattern.
# `redact` (default) replaces matched patterns with placeholders before
#   the query leaves our network.
# `allow` lets raw queries through (only set this if you understand the
#   vendor's privacy policy and trust their handling).
CCE_WEB_SEARCH_PII_POLICY=

# ── Cross-surface owner aliasing (C3) ────────────────────────────────
# If you DM the bot from both Slack and Telegram, listing your IDs here
# routes both into a single memory namespace `owner:<label>`. Leave blank
# to keep each surface in its own namespace (default).
#   CCE_OWNER_TELEGRAM_CHATS  CSV of your Telegram chat IDs
#   CCE_OWNER_SLACK_USERS     CSV of your Slack user IDs (Uxxxxxxxx)
#   CCE_OWNER_LABEL           label used in the synthetic chatId, default `owner`
CCE_OWNER_TELEGRAM_CHATS=
CCE_OWNER_SLACK_USERS=
CCE_OWNER_LABEL=

# ── Cost & network options ────────────────────────────────────────────
# Opt-in VPC interface endpoints (~15 endpoints x 2 AZs, roughly $220/mo).
# Default off: with NAT present, tasks already reach every AWS API. Set to 1
# only when PrivateLink isolation is a requirement.
CCE_PRIVATE_ENDPOINTS=

# Paperclip work engine substrate (ADR 0010): an Aurora Serverless v2 cluster
# and an EFS filesystem, both RETAINed and the cluster deletion-protected.
# Default off: nothing consumes them yet, and ungated they put first-time
# Aurora and EFS creation on the path of every routine app deploy. Set to 1
# only when arming Paperclip deliberately, with someone watching.
CCE_PAPERCLIP_ENABLED=
#
# Paperclip's better-auth signing secret. `npm run setup` GENERATES this
# once and writes it here; deploy phase b merges it into the
# /claudeclaw[-suffix]/paperclip secret without disturbing the reconciler,
# agent and dispatch keys minted against the running instance later.
# Keep it stable: changing it invalidates every Paperclip session.
PAPERCLIP_BETTER_AUTH_SECRET=

# Cost Anomaly monitor to attach the alert subscription to. Usually leave
# blank: the deploy auto-discovers the account's existing DIMENSIONAL/SERVICE
# monitor (AWS allows exactly one per account) and creates one only when none
# exists. Set explicitly if the deploying principal lacks ce:GetAnomalyMonitors.
CCE_ANOMALY_MONITOR_ARN=

# ── Deployment outputs (set by deploy script) ────────────────────────
ALB_DNS_NAME=
DASHBOARD_URL=
DEPLOYED_AT=
