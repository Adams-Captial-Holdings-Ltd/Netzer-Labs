#!/usr/bin/env bash
# pre-push: refuse unless every "<local sha> -> <remote ref>" has an unused owner-yes record.
# Logs every attempt (sha, ref, result) to push-attempts.jsonl; never file contents.
set -u
LOGS="${NETZAR_LOG_DIR:-$HOME/.claude/plans/netzar-logs}"
APPROVALS="${NETZAR_APPROVALS:-$HOME/.claude/plans/netzar-push-approvals.jsonl}"
mkdir -p "$LOGS" "$(dirname "$APPROVALS")"

# check-and-consume under one lock, so concurrent or repeated pushes cannot share an approval
exec 8>"$APPROVALS.lock"
flock 8

rc=0
while read -r _lref lsha rref _rsha; do
  ok=false
  # an all-zero sha is a branch delete: never approvable
  if [ -s "$APPROVALS" ] && [ -n "${lsha//0/}" ]; then
    ok=$(jq -s --arg s "$lsha" --arg r "$rref" \
      '[.[]|select(.sha==$s and .ref==$r)] | ([.[]|select(.event==null and .used!=true and ((.owner_text//"")|length)>0)]|length) > ([.[]|select(.event=="used")]|length)' \
      "$APPROVALS" 2>/dev/null || echo false)
  fi
  reason=""
  if [ "$ok" = true ]; then
    res=allowed
    # fail closed: an approval we could not mark used stays reusable, so refuse
    if ! jq -nc --arg ts "$(date -u +%FT%TZ)" --arg sha "$lsha" --arg ref "$rref" '{ts:$ts,sha:$sha,ref:$ref,event:"used"}' >>"$APPROVALS"; then
      res=refused; rc=1
      reason="could not record approval use for ${lsha:0:12} -> $rref"
      echo "$reason" >&2
    fi
  else
    res=refused; rc=1
    reason="no owner yes for ${lsha:0:12} -> $rref"
    echo "$reason" >&2
  fi
  jq -nc --arg ts "$(date -u +%FT%TZ)" --arg sha "$lsha" --arg ref "$rref" --arg res "$res" --arg why "$reason" \
    '{ts:$ts,sha:$sha,ref:$ref,result:$res,reason:$why}' >>"$LOGS/push-attempts.jsonl" || { echo "could not log push attempt" >&2; rc=1; }
done
exit $rc
