{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "~/*": ["src/spike/lc/*"],
      "recoil": ["src/spike/lc/shims/recoil.ts"],
      "@librechat/client": ["src/spike/lc/shims/librechat-client.tsx"],
      "librechat-data-provider": ["src/spike/lc/shims/librechat-data-provider.ts"],
      "react": ["node_modules/preact/compat/src/index.d.ts"],
      "react-dom": ["node_modules/preact/compat/src/index.d.ts"],
      "react/jsx-runtime": ["node_modules/preact/jsx-runtime/src/index.d.ts"]
    }
  },
  "include": ["src"]
}
