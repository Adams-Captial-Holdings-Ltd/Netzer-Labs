# =====================================================================
# Netzar OS Enterprise · STAGING env template
# Copy to .env.staging and fill in. .env.staging is gitignored.
# Deploy with: npm run deploy -- --env=staging --yes
# =====================================================================

# ── AWS context ───────────────────────────────────────────────────────
# Same account as prod (single-tenant model). CDK_STACK_NAME=CCE-STAGING
# prefix isolates all 10 stacks from prod (CCE-...).
AWS_ACCOUNT_ID=<your-aws-account-id>
AWS_REGION=us-east-1

# ── Bedrock (safe to reuse prod model IDs — account-level) ────────────
BEDROCK_DEFAULT_MODEL=
BEDROCK_OPUS_MODEL=
BEDROCK_SONNET_MODEL=
BEDROCK_HAIKU_MODEL=
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
# Bedrock guardrail can be reused from prod (account-level); leave the
# DRAFT version unless you have a published version pinned.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ── Deploy targets ────────────────────────────────────────────────────
CDK_STACK_NAME=CCE-STAGING
ECR_REPO_NAME=claudeclaw-orchestrator-staging
DEPLOY_TIER=1
CCE_TIER=1
DEPLOY_MANIFEST_BUCKET=claudeclaw-deploy-staging-<your-aws-account-id>-us-east-1

# Tight cost cap so staging can never blow the budget.
CCE_DAILY_COST_CAP_USD=10

# ── Surfaces (provide your STAGING-specific tokens) ──────────────────
# Slack: register a separate app at api.slack.com/apps with the same
# manifest as prod but a different bot user. Webhook target will be
# https://staging.<your-domain>/slack/events
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# Telegram: ask BotFather for a new bot (/newbot). Webhook will be
# https://staging.<your-domain>/tg/main/webhook
TELEGRAM_TOKENS_JSON=
TELEGRAM_WEBHOOK_SECRET=

# ── HTTPS / public hostname ──────────────────────────────────────────
# Use a subdomain of a domain YOU control. If its Route 53 hosted zone
# lives in the same account, CDK will auto-issue the ACM cert + add an
# A record for the staging subdomain.
DOMAIN_NAME=staging.<your-domain>
ACM_CERT_ARN=

# ── Dashboard (generate fresh values, do NOT reuse prod) ─────────────
DASHBOARD_TOKEN=
DASHBOARD_PORT=3000
SECURITY_PIN_HASH=
EMERGENCY_KILL_PHRASE=
APP_ENCRYPTION_KEY=

# ── Runtime ───────────────────────────────────────────────────────────
NODE_ENV=staging
LOG_LEVEL=debug
PORT=3000
CONFIG_CACHE_TTL_SECONDS=60
