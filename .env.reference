# =====================================================================
# Netzar OS Enterprise · .env.reference
# =====================================================================
#
# THIS FILE IS DOCUMENTATION ONLY. It is the annotated reference for
# every environment variable the system reads. Your real `.env` is
# written by `npm run setup` and updated by `npm run deploy`; it is
# NEVER committed (`.env` and `.env.*` are gitignored — only this
# reference and the `*.example` templates are tracked).
#
# Every variable below corresponds to a real read in the codebase; the
# source file of each read is named in its annotation.
#
# ── Tags (one per variable) ──────────────────────────────────────────
# [WIZARD]        `npm run setup` writes it into .env. You normally
#                 never hand-edit these; re-run the wizard instead.
# [CDK_OUTPUT]    Populated by the deploy pipeline, not by hand:
#                 either written back into .env after stack outputs
#                 (ALB_DNS_NAME, DASHBOARD_URL, DEPLOYED_AT), set by
#                 the deploy script for `cdk synth` (CCE_IMAGE_TAG,
#                 CDK_DEFAULT_*), or injected into the ECS task
#                 definition at deploy (buckets, tables, queues,
#                 secret ARNs). Task-definition vars never need to
#                 appear in your local .env at all.
# [OPTIONAL]      Feature/opt-in or tunable with a safe default.
#                 Unset = default behavior.
# [LIVE_EDITABLE] A runtime-config row (DDB `claudeclaw-runtime-config`
#                 table, editable from the dashboard) supersedes the
#                 env value live, within ~30 s, no redeploy.
#
# Ground truth: src/config/env.ts (zod schema), scripts/setup.ts,
# scripts/deploy.ts (cdkEnvBag + required pre-check),
# scripts/lib/lifecycle/deploy-phases.ts (secret seeding),
# infra/bin/app.ts and infra/lib/*.ts (synth-time process.env reads).
# =====================================================================


# ─────────────────────────────────────────────────────────────────────
# 1. AWS context
# ─────────────────────────────────────────────────────────────────────

# [WIZARD] Target AWS account ID for all stacks. Required by scripts/deploy.ts
# pre-check; read at runtime by src/config/env.ts. No default.
AWS_ACCOUNT_ID=

# [WIZARD] Deploy/runtime region. Required by scripts/deploy.ts; runtime
# default in src/config/env.ts is us-east-1.
AWS_REGION=us-east-1


# ─────────────────────────────────────────────────────────────────────
# 2. Bedrock
# ─────────────────────────────────────────────────────────────────────

# [WIZARD] Default model id (cross-region inference profile). The wizard sets
# it to the Sonnet profile. Synth fallback chain (compute-stack.ts):
# DEFAULT → SONNET → BEDROCK_MODELS.sonnet constant. Runtime readiness
# requires at least one real BEDROCK_*_MODEL (src/config/env.ts).
BEDROCK_DEFAULT_MODEL=

# [WIZARD] Opus inference profile id. Synth falls back to the
# BEDROCK_MODELS.opus constant (infra/lib/compute-stack.ts).
BEDROCK_OPUS_MODEL=

# [WIZARD] Sonnet inference profile id (the workhorse model).
BEDROCK_SONNET_MODEL=

# [WIZARD] Haiku inference profile id (cheap/fast paths, mission auto-assign).
BEDROCK_HAIKU_MODEL=

# [OPTIONAL] 1M-context Opus variant; synth-only read in
# infra/lib/compute-stack.ts, falls back to the BEDROCK_MODELS.opus1m constant.
BEDROCK_OPUS_1M_MODEL=

# [OPTIONAL] 1M-context Sonnet variant; same mechanics as the Opus 1M var.
BEDROCK_SONNET_1M_MODEL=

# [OPTIONAL] Embeddings model for Knowledge ingest/search.
# Default: amazon.titan-embed-text-v2:0 (src/config/env.ts).
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# [CDK_OUTPUT] Bedrock guardrail id. Created by the guardrails stack in deploy
# phase (a) and injected into the task env from Secrets Manager; read by
# src/config/env.ts. Unset = guardrail checks skipped.
BEDROCK_GUARDRAIL_ID=

# [OPTIONAL] Guardrail version to invoke. Default: DRAFT (src/config/env.ts).
BEDROCK_GUARDRAIL_VERSION=DRAFT


# ─────────────────────────────────────────────────────────────────────
# 3. Deploy targets
# ─────────────────────────────────────────────────────────────────────

# [WIZARD] ECR repository name for the orchestrator image. Required by
# scripts/deploy.ts pre-check. No default.
ECR_REPO_NAME=

# [WIZARD] CloudFormation stack-name prefix for all stacks. Required by
# scripts/deploy.ts; infra/bin/app.ts falls back to `CCE` when unset at synth.
CDK_STACK_NAME=CCE

# [WIZARD] Deploy tier 0–3 (sizing, features, cost posture). Read by
# scripts/deploy.ts (also overridable per-run via `--tier=`); infra/bin/app.ts
# reads CCE_TIER first, then DEPLOY_TIER. Default: 1.
DEPLOY_TIER=1

# [WIZARD] Mirror of DEPLOY_TIER written by the wizard; takes precedence at
# synth (infra/bin/app.ts) and is injected into the task env by compute-stack.
CCE_TIER=1

# [WIZARD] S3 bucket for deploy manifests / lifecycle state (bootstrap-state).
DEPLOY_MANIFEST_BUCKET=

# [WIZARD] Local config workspace directory recorded by the wizard
# (scripts/setup.ts, `CLAUDECLAW_CONFIG: state.configDir`).
CLAUDECLAW_CONFIG=

# [OPTIONAL] Suffix for every named resource (`claudeclaw[-suffix]-*`) so a
# second install (e.g. staging) can share the account. Read at synth by
# infra/lib/constants.ts; deploy derives it from `--env=` when unset.
# Default: empty (prod).
CCE_NAME_SUFFIX=

# [OPTIONAL] Public hostname. When set, CDK issues an ACM cert via Route 53
# DNS validation, adds the alias record, and configures HTTPS:443. Read at
# synth (compute-stack, security-stack, storage-stack CORS, deploy-mode.ts)
# and forwarded by scripts/deploy.ts cdkEnvBag. The wizard writes it when you
# provide one. Unset + chat mode = webhooks will not work (HTTPS required).
DOMAIN_NAME=

# [OPTIONAL] Existing ACM certificate ARN if you manage DNS yourself
# (alternative to DOMAIN_NAME auto-issue). Read at synth in compute-stack.ts.
ACM_CERT_ARN=

# [OPTIONAL] Use an existing Route 53 hosted zone by ID instead of looking it
# up by the 2-segment apex of DOMAIN_NAME. Set this when the apex zone lives
# elsewhere and only a subzone is delegated into this account/region — e.g.
# DOMAIN_NAME=cce.example.com with only `cce.example.com` delegated to R53.
# When set, CDK uses HostedZone.fromHostedZoneAttributes (no lookup) and
# derives alias record names relative to HOSTED_ZONE_NAME, so records land at
# the zone apex (no `cce.cce.example.com` double-qualify). Read at synth in
# infra/lib/compute-stack.ts.
HOSTED_ZONE_ID=

# [OPTIONAL] The apex/name of the hosted zone referenced by HOSTED_ZONE_ID
# (e.g. `cce.example.com` for a delegated subzone, or `example.com` for a
# whole zone). Required to be correct whenever HOSTED_ZONE_ID is set; defaults
# to the 2-segment apex of DOMAIN_NAME if omitted. Read at synth in
# infra/lib/compute-stack.ts.
HOSTED_ZONE_NAME=


# ─────────────────────────────────────────────────────────────────────
# 4. Mode & features
# ─────────────────────────────────────────────────────────────────────

# [WIZARD] Deployment mode: `chat` (default — webhook surfaces are
# first-class, readiness needs a real surface token) or `infra-only`
# (dashboard-only; with no DOMAIN_NAME the ALB synthesizes INTERNAL and the
# only access path is `npm run dashboard:tunnel`). Read by
# infra/lib/deploy-mode.ts at synth and src/config/env.ts at runtime.
CCE_DEPLOY_MODE=chat

# [WIZARD] Knowledge ingestion/embeddings feature flag. Default on; `0`
# disables (and the Titan-embed model grant is no longer probed).
CCE_KNOWLEDGE_ENABLED=1

# [WIZARD] Nova Canvas image generation tools. Default on; `0` disables at
# boot. The `image_gen_disabled` kill switch toggles it live without a deploy.
CCE_IMAGE_GEN_ENABLED=1

# [WIZARD] Polly TTS voice replies. Default on; `0` disables at boot. The
# `tts_disabled` kill switch toggles it live.
CCE_TTS_ENABLED=1

# [OPTIONAL] Verified SES sender address for the email tools and dashboard
# invites. Unset = email sending unavailable. Read by src/config/env.ts;
# injected into the task env by compute-stack.
CCE_EMAIL_FROM=

# [OPTIONAL] Jarvis voice co-pilot launch gate ("true" = on). The wizard
# writes it when you answer the Jarvis question; compute-stack injects
# `true` when unset at synth, while the runtime treats unset as OFF
# (fail-closed, src/lib/jarvis/jarvis-flags.ts). The `jarvis_disabled` and
# `jarvis_voice_disabled` kill switches gate it live.
JARVIS_LAUNCH_ENABLED=

# [OPTIONAL] Outbound PII policy for web_search queries: refuse | redact |
# allow. Default behavior: redact (src/config/env.ts).
CCE_WEB_SEARCH_PII_POLICY=

# [OPTIONAL] CSV of Telegram chat IDs that map to the single synthetic owner
# chatId (cross-surface memory aliasing). Default: unset (no aliasing).
CCE_OWNER_TELEGRAM_CHATS=

# [OPTIONAL] CSV of Slack user IDs (Uxxxxxxxx) for the same owner aliasing.
CCE_OWNER_SLACK_USERS=

# [OPTIONAL] Label used in the synthetic owner chatId. Default: `owner`
# (src/lib/identity/owner-alias.ts).
CCE_OWNER_LABEL=

# [OPTIONAL] Set to `1` to bypass the identities-table resolver and use the
# legacy per-surface chatId shape. Rollback knob (src/config/env.ts).
CCE_IDENTITY_RESOLUTION_DISABLED=


# ─────────────────────────────────────────────────────────────────────
# 5. Surfaces (chat adapters)
# ─────────────────────────────────────────────────────────────────────
# Deploy seeds these into Secrets Manager (deploy-phases.ts); at runtime the
# ECS task definition injects them back as env vars. An unpopulated secret
# injects REPLACE_ME, which the runtime treats as "not configured".

# [WIZARD] Slack bot token (xoxb-…). Written when you connect Slack in setup.
SLACK_BOT_TOKEN=

# [WIZARD] Slack signing secret for request signature verification.
SLACK_SIGNING_SECRET=

# [OPTIONAL] Slack app-level token (xapp-…); seeded to the Slack secret by
# deploy-phases.ts when present.
SLACK_APP_TOKEN=

# [WIZARD] Telegram bot tokens, JSON map of agent-id → BotFather token
# (e.g. {"main":"123:ABC"}). Written when you connect Telegram in setup.
TELEGRAM_TOKENS_JSON=

# [WIZARD] Shared secret Telegram echoes back in the X-Telegram-Bot-Api-
# Secret-Token header on every webhook call.
TELEGRAM_WEBHOOK_SECRET=


# ─────────────────────────────────────────────────────────────────────
# 6. Dashboard & security
# ─────────────────────────────────────────────────────────────────────

# [WIZARD] Bearer token for dashboard/API auth. Generated by setup, seeded to
# Secrets Manager by deploy, injected into the task env. In `infra-only` mode
# this is what readiness requires (src/config/env.ts).
DASHBOARD_TOKEN=

# [WIZARD] App-level encryption key for at-rest encryption of sensitive DDB
# fields. Generated by setup; seeded to the db-encryption secret.
APP_ENCRYPTION_KEY=

# [WIZARD] Hash of the dashboard security PIN (written only if you set a PIN
# in setup; seeded to the dashboard secret by deploy-phases.ts).
SECURITY_PIN_HASH=

# [WIZARD] Emergency kill phrase. Generated by setup; seeded to the dashboard
# secret's kill_phrase field. Typing it in any chat halts all agents ONCE the
# kill-phrase wiring is deployed to the task (PR #102); on tasks without the
# env mapping it is stored but dormant. The always-available emergency stop
# is the dashboard panic/kill-switch controls.
EMERGENCY_KILL_PHRASE=

# [OPTIONAL] Public dashboard base URL. Used to build magic-link/invite URLs
# (src/lib/auth/magic-link.ts, src/lib/email/invite-email.ts) and the
# /dashboard command reply (src/agent/commands.ts). Unset = falls back to
# DASHBOARD_URL, else links are unavailable.
CCE_DASHBOARD_URL=

# [OPTIONAL] Tunnel hostname fallback for dashboard links when there is no
# public URL (src/agent/commands.ts).
CCE_TUNNEL_DOMAIN=

# [OPTIONAL] Power-switch panel cost line, e.g. "Paused about $150 to $170/mo.
# Awake about $650 to $750/mo." Synth-time env → power Lambda COST_NOTE
# (infra/lib/power-switch-stack.ts). Shown on the panel and the dashboard
# Power card. Also set as a GitHub Variable so cdk-drift synth matches.
CCE_POWER_COST_NOTE=

# [OPTIONAL] Reserved concurrency for the power-switch Lambda. Defaults to 5.
# Set to 0 only as a temporary bridge when the AWS account's applied regional
# Lambda concurrency quota is 10; this omits the reservation so CloudFormation
# can deploy while AWS reviews a quota-increase request. Restore to 5 after the
# quota is approved.
CCE_POWER_RESERVED_CONCURRENCY=5

# [OPTIONAL] [LIVE_EDITABLE runtime-config power/url] Function URL of the
# power-switch Lambda. Two uses: (1) fallback for the dashboard's /api/power
# proxy when the runtime-config key is unset (normally written by
# `npm run power:setup`, 30s propagation, no deploy); (2) SYNTH-TIME input to
# security-stack — when set, a Lambda@Edge origin-response function on the
# CloudFront distribution redirects paused-mode page loads (origin 502/503/
# 504) to the power panel. Set it as a GitHub Variable too so cdk-drift synth
# matches the deployed distribution.
CCE_POWER_URL=

# [OPTIONAL] Secrets Manager id of the power token the /api/power proxy reads
# server-side (default claudeclaw/power-switch-token).
CCE_POWER_TOKEN_SECRET=


# ─────────────────────────────────────────────────────────────────────
# 7. CI (both paths default OFF; either requires explicit GitHub coords —
#    synth fails closed with no default, so a fork can never inherit the
#    upstream repo's deploy authority)
# ─────────────────────────────────────────────────────────────────────

# [OPTIONAL] `1` enables GitHub Actions OIDC deploys (iam-stack creates the
# deploy role with exact-subject trust). Skipped on suffixed (staging)
# deploys. Default: off.
CCE_CICD_ENABLED=

# [OPTIONAL] `1` enables CodeBuild tag deploys (infra/bin/app.ts adds the
# CodeBuild stack; requires a GitHub PAT imported via
# `aws codebuild import-source-credentials`). Default: off.
CCE_CODEBUILD_ENABLED=

# [OPTIONAL] GitHub org/user for either CI path. REQUIRED (no default) when
# a CI flag is `1` — infra/lib/github-oidc.ts and infra/bin/app.ts throw
# without it.
CCE_GITHUB_OWNER=

# [OPTIONAL] GitHub repository name. Same fail-closed requirement as owner.
CCE_GITHUB_REPO=

# [OPTIONAL] Branch CodeBuild watches. Default: main (infra/bin/app.ts).
# KNOWN GAP: `main` was deleted when the branch set was reduced to
# development/qa/staging/production, so the default now names a branch that
# does not exist. Set this explicitly (`production`) if you enable CodeBuild.
CCE_GITHUB_BRANCH=

# [OPTIONAL] CSV of fully-qualified refs trusted to assume the OIDC deploy
# role (e.g. refs/heads/production). At least one of REFS/ENVIRONMENTS required
# when CCE_CICD_ENABLED=1; wildcards rejected (infra/lib/github-oidc.ts).
CCE_GITHUB_DEPLOY_REFS=

# [OPTIONAL] CSV of GitHub Environment names trusted for OIDC deploys
# (alternative/addition to refs).
CCE_GITHUB_DEPLOY_ENVIRONMENTS=


# ─────────────────────────────────────────────────────────────────────
# 8. Vendor keys (add-on tools; a tool registers itself only when its key
#    is present — src/config/env.ts treats REPLACE_ME/empty as unset)
# ─────────────────────────────────────────────────────────────────────
# Deploy seeds these into the vendor-keys secret (deploy-phases.ts); the task
# definition injects them at start.

# [OPTIONAL] Tavily key — arms web_search via Tavily.
TAVILY_API_KEY=

# [OPTIONAL] Brave Search key — alternate web_search provider.
BRAVE_SEARCH_API_KEY=

# [OPTIONAL] Exa key — alternate web_search provider.
EXA_API_KEY=

# [OPTIONAL] Serper key — alternate web_search provider.
SERPER_API_KEY=

# [OPTIONAL] Google Gemini key — seeded to the vendor-keys secret
# (deploy-phases.ts); arms Gemini-backed tooling.
GOOGLE_GEMINI_API_KEY=


# ─────────────────────────────────────────────────────────────────────
# 9. Runtime tunables
# ─────────────────────────────────────────────────────────────────────

# [OPTIONAL] Node environment: development | production | test.
# Default: development (src/config/env.ts).
NODE_ENV=development

# [OPTIONAL] HTTP listen port. Default: 3000.
PORT=3000

# [OPTIONAL] Log level: fatal|error|warn|info|debug|trace. Default: info.
LOG_LEVEL=info

# [OPTIONAL] S3/agent config cache TTL in seconds. Default: 300, min 10.
CONFIG_CACHE_TTL_SECONDS=300

# [LIVE_EDITABLE] Daily Bedrock spend cap in USD. The runtime-config row
# `cost/daily_cap_usd` supersedes this live (src/lib/state/cost-cap-repo.ts);
# the env var is only the fallback. Note: compute-stack pins the TASK env
# value to the tier default at synth (deliberately ignoring the deploy
# shell), so in a deployed task this var matters only until the runtime-config
# row is set. Hard-coded last resort: 50.
CCE_DAILY_COST_CAP_USD=

# [WIZARD] `1` = the setup operator chose day-one cap enforcement: seeding
# substitutes runtime-config `cost/cap_enabled` to `true` on the FIRST deploy
# (scripts/lib/seed-defaults.ts applyEnvOverrides), so the cap above blocks
# paid turns fail-closed from the start. `0`/unset = cap saved but not
# enforced until flipped in the dashboard Cost tab. Existing installs are
# never changed by this (conditional puts).
CCE_COST_CAP_ENFORCED=

# [OPTIONAL] Legacy in-process scheduler tick interval in seconds.
# Default: 30, clamped to ≤600 (src/agent/scheduler.ts).
CCE_SCHEDULER_TICK_SEC=

# [OPTIONAL] `1` disables the in-process scheduler tick entirely
# (src/agent/scheduler.ts).
CCE_SCHEDULER_DISABLED=

# [OPTIONAL] `1` falls back to the legacy DDB-polling scheduler and skips
# EventBridge Scheduler + queue drain. Default: 0 = use EB Scheduler.
CCE_USE_IN_PROCESS_SCHEDULER=

# [OPTIONAL] `1` disables Telegram voice transcription (Amazon Transcribe)
# (src/adapters/telegram/media.ts).
CCE_TRANSCRIBE_DISABLED=

# [OPTIONAL] Bedrock prompt caching. Default on; `0` disables
# (src/lib/bedrock/client.ts, src/agent/agent-loop.ts).
CCE_PROMPT_CACHE=

# [OPTIONAL] `1` shows the model/cost footer on chat replies. Default: off
# (src/adapters/telegram/handler.ts, src/adapters/slack/handler.ts).
CCE_SHOW_FOOTER=

# ── Jarvis voice co-pilot knobs (all read by src/config/env.ts; live gating
#    is via the jarvis_* kill switches) ────────────────────────────────

# [OPTIONAL] Nova Sonic model id for Jarvis voice.
# Default: amazon.nova-2-sonic-v1:0.
NOVA_SONIC_MODEL=

# [OPTIONAL] Max Jarvis voice session length in seconds. Default: 420,
# hard ceiling 480 (the Nova bidirectional stream closes at 8 min).
JARVIS_MAX_SESSION_SECONDS=

# [OPTIONAL] Nova native voice id (lowercase). Default: amy (en-GB).
JARVIS_VOICE_ID=

# [OPTIONAL] Max concurrent Jarvis voice sessions. Default: 5.
JARVIS_MAX_CONCURRENT_SESSIONS=

# [OPTIONAL] Polly voice for the greeting kick + Telegram voice replies
# (not on the Jarvis speech path). Default: Amy.
JARVIS_TTS_VOICE_ID=

# [OPTIONAL] Polly engine for the same paths. Default: generative.
JARVIS_TTS_ENGINE=

# [OPTIONAL] SSML prosody rate for the same Polly paths. Default: 116%.
JARVIS_TTS_RATE=

# [OPTIONAL] Polly language code for the same paths. Default: en-GB.
JARVIS_TTS_LANGUAGE=

# [OPTIONAL] Pin an exact Jarvis opening line. Default: unset — Jarvis
# composes its own greeting at runtime (adapters/dashboard/jarvis.ts).
JARVIS_GREETING=

# [OPTIONAL] HTTP/2 stream timeout for the Nova connection in ms.
# Default: 470000 (≥ session length).
NOVA_HTTP2_TIMEOUT_MS=


# ─────────────────────────────────────────────────────────────────────
# 10. Deploy outputs & task environment — all [CDK_OUTPUT]
# ─────────────────────────────────────────────────────────────────────
# Everything in this section is populated by the pipeline. The first three
# are written back into your .env by scripts/deploy.ts after stack outputs;
# the rest are injected into the ECS task definition by
# infra/lib/compute-stack.ts (from RESOURCE_NAMES / stack wiring) and exist
# in .env only if you want local runs against deployed infra.

# [CDK_OUTPUT] ALB DNS name, written back to .env post-deploy (status reads it).
ALB_DNS_NAME=

# [CDK_OUTPUT] https://<ALB DNS>, written back to .env post-deploy. Also a
# fallback for invite/magic links when CCE_DASHBOARD_URL is unset.
DASHBOARD_URL=

# [CDK_OUTPUT] ISO timestamp of the last deploy, written back to .env.
DEPLOYED_AT=

# ── S3 buckets ──
# [CDK_OUTPUT] Config bucket — agent prompts (agents/<id>/CLAUDE.md) + agent.yaml.
CONFIG_BUCKET=
# [CDK_OUTPUT] Raw media/uploads bucket.
RAW_BUCKET=
# [CDK_OUTPUT] Curated knowledge bucket.
CURATED_BUCKET=
# [CDK_OUTPUT] Vector staging bucket (browser-PUT uploads land here).
VECTORS_STAGING_BUCKET=
# [CDK_OUTPUT] Alias read by src/lib/vectors/store.ts; compute-stack points it
# at the staging bucket.
VECTORS_BUCKET=
# [CDK_OUTPUT] WORM audit-lock bucket (Object Lock; tier-gated, T2+).
AUDIT_LOCK_BUCKET=

# ── DynamoDB tables (names default to claudeclaw[-suffix]-* in code when
#    unset; compute-stack injects the real names) ──
# [CDK_OUTPUT] Chat sessions.
TABLE_SESSIONS=
# [CDK_OUTPUT] Cross-agent shared scratchpad (hive mind).
TABLE_HIVE_MIND=
# [CDK_OUTPUT] Append-only audit log.
TABLE_AUDIT_LOG=
# [CDK_OUTPUT] Per-chat config (sticky agent, model overrides).
TABLE_CHAT_CONFIG=
# [CDK_OUTPUT] Token/cost usage rollups.
TABLE_TOKEN_USAGE=
# [CDK_OUTPUT] Long-term memories.
TABLE_MEMORIES=
# [CDK_OUTPUT] Memory consolidation runs.
TABLE_CONSOLIDATIONS=
# [CDK_OUTPUT] Agent CLAUDE.md revision history.
TABLE_AGENT_FILE_HISTORY=
# [CDK_OUTPUT] Mission Control tracked work units.
TABLE_MISSION_TASKS=
# [CDK_OUTPUT] Scheduled tasks.
TABLE_SCHEDULED_TASKS=
# [CDK_OUTPUT] Kill switches.
TABLE_KILL_SWITCHES=
# [CDK_OUTPUT] Inter-agent DM/inbox tasks.
TABLE_INTER_AGENT_TASKS=
# [CDK_OUTPUT] Context compaction events.
TABLE_COMPACTION_EVENTS=
# [CDK_OUTPUT] Queue lease/lock rows.
TABLE_QUEUE_LEASE=
# [CDK_OUTPUT] Atomic daily spend ledger (reserve-before-spend cap, C2-full).
# Day + reservation items; the runtime-config arm is `cost/ledger_enabled`
# [LIVE_EDITABLE] and the per-turn hold is `cost/ledger_reserve_usd`
# [LIVE_EDITABLE] (src/lib/cost/ledger-gate.ts).
TABLE_SPEND_LEDGER=
# [CDK_OUTPUT] Cross-surface identity resolution.
TABLE_IDENTITIES=
# [CDK_OUTPUT] Agent registry rows (PK AGENT#<id>, SK META —
# src/lib/state/agents-repo.ts).
TABLE_AGENTS=
# [CDK_OUTPUT] Runtime-config key-value store (PK CONFIG#<category>, SK <key>).
TABLE_RUNTIME_CONFIG=
# [CDK_OUTPUT] Rate-limit counters.
TABLE_RATE_LIMITS=
# [CDK_OUTPUT] Dashboard session tokens (src/lib/state/tokens-repo.ts; direct
# process.env read, not in the zod schema).
TABLE_DASHBOARD_TOKENS=
# [CDK_OUTPUT] Dashboard users (src/lib/state/users-repo.ts; direct read).
TABLE_USERS=

# ── Messaging / scheduling wiring ──
# [CDK_OUTPUT] Knowledge-ingest SQS queue URL.
INGEST_QUEUE_URL=
# [CDK_OUTPUT] Config-invalidation SNS topic ARN (fast cache fanout).
CCE_CONFIG_TOPIC_ARN=
# [CDK_OUTPUT] Ops-alert SNS topic ARN (alert-recipient admin console).
CCE_ALERT_TOPIC_ARN=
# [CDK_OUTPUT] EventBridge Scheduler fire queue URL.
SCHEDULED_FIRE_QUEUE_URL=
# [CDK_OUTPUT] EventBridge Scheduler fire queue ARN.
SCHEDULED_FIRE_QUEUE_ARN=
# [CDK_OUTPUT] EventBridge Scheduler group name.
SCHEDULER_GROUP_NAME=
# [CDK_OUTPUT] IAM role EB Scheduler assumes to enqueue fires.
SCHEDULER_ROLE_ARN=

# ── Tier/status identity injected by compute-stack ──
# [CDK_OUTPUT] Human-readable tier label shown in the dashboard.
CCE_TIER_LABEL=
# [CDK_OUTPUT] `1` when the tier enables X-Ray tracing.
CCE_XRAY_ENABLED=
# [CDK_OUTPUT] `1` when the tier enables the canary.
CCE_CANARY_ENABLED=
# [CDK_OUTPUT] App-name prefix (claudeclaw[-suffix]) used to filter
# CloudWatch alarms on /status.
CCE_RESOURCE_PREFIX=
# [CDK_OUTPUT] Compute stack name, used to pull recent deploy events on /status.
CCE_COMPUTE_STACK=

# ── Security-posture read targets (/api/posture/*; metadata only, never
#    secret values; when unset the readers discover via list/describe) ──
# [CDK_OUTPUT] CloudTrail trail name.
CCE_CLOUDTRAIL_NAME=
# [CDK_OUTPUT] KMS alias for the data key.
CCE_KMS_DATA_KEY_ALIAS=
# [CDK_OUTPUT] KMS alias for the curated-bucket key.
CCE_KMS_CURATED_KEY_ALIAS=
# [CDK_OUTPUT] KMS alias for the logs key.
CCE_KMS_LOGS_KEY_ALIAS=
# [CDK_OUTPUT] Secrets Manager ARN — Slack secret.
CCE_SECRET_SLACK_ARN=
# [CDK_OUTPUT] Secrets Manager ARN — Telegram secret.
CCE_SECRET_TELEGRAM_ARN=
# [CDK_OUTPUT] Secrets Manager ARN — dashboard secret.
CCE_SECRET_DASHBOARD_ARN=
# [CDK_OUTPUT] Secrets Manager ARN — db-encryption secret.
CCE_SECRET_DB_ENCRYPTION_ARN=
# [CDK_OUTPUT] Secrets Manager ARN — Bedrock guardrails secret.
CCE_SECRET_BEDROCK_GUARDRAILS_ARN=
# [CDK_OUTPUT] Secrets Manager ARN — vendor-keys secret.
CCE_SECRET_VENDOR_KEYS_ARN=


# ─────────────────────────────────────────────────────────────────────
# 11. Synth-only (read from the shell env during `cdk synth`/deploy;
#     never read by the running orchestrator)
# ─────────────────────────────────────────────────────────────────────

# [CDK_OUTPUT] Immutable per-deploy image tag the task definition pins
# (never `latest`). Set by scripts/deploy.ts cdkEnvBag; read in
# infra/lib/compute-stack.ts. Never set by hand.
CCE_IMAGE_TAG=

# [CDK_OUTPUT] Git SHA recorded into the task env for /status; falls back to
# `git rev-parse` at synth (infra/lib/compute-stack.ts).
DEPLOY_SHA=

# [CDK_OUTPUT] CDK environment account, set by scripts/deploy.ts from
# AWS_ACCOUNT_ID (infra/bin/app.ts falls back to AWS_ACCOUNT_ID directly).
CDK_DEFAULT_ACCOUNT=

# [CDK_OUTPUT] CDK environment region, set by scripts/deploy.ts from
# AWS_REGION. Synth default: us-east-1.
CDK_DEFAULT_REGION=

# [OPTIONAL] Override for the X-CloudFront-Origin header secret that gates
# the ALB behind CloudFront (rotation knob). Default: deterministic
# SHA256(account-region-cf-origin-v1)[:32] (infra/lib/cf-origin-secret.ts).
CCE_CF_ORIGIN_SECRET=

# [OPTIONAL] `1` adds VPC interface endpoints instead of NAT-routed AWS API
# traffic (infra/lib/network-stack.ts). Default: off.
CCE_PRIVATE_ENDPOINTS=

# [OPTIONAL] `1` enables the AWS Config recorder + delivery channel wiring in
# infra/lib/security-stack.ts (needs the out-of-band Config role bootstrap).
# Default: off.
CCE_CONFIG_ENABLED=

# [OPTIONAL] Email for the cost-guardrails budget/anomaly SNS subscription
# (infra/lib/cost-guardrails-stack.ts). Unset = no email subscription.
CCE_COST_ALERT_EMAIL=

# [OPTIONAL] Monthly AWS budget in USD for cost-guardrails. Default: 600.
CCE_MONTHLY_BUDGET_USD=

# [OPTIONAL] Minimum anomaly size in USD before the anomaly monitor alerts.
# Default: 25 (infra/lib/cost-guardrails-stack.ts).
CCE_ANOMALY_MIN_USD=

# [OPTIONAL] Existing Cost Anomaly Monitor ARN to reuse instead of creating
# one (infra/lib/cost-guardrails-stack.ts).
CCE_ANOMALY_MONITOR_ARN=

# [OPTIONAL] Passed through into the CodeBuild project env
# (infra/lib/codebuild-stack.ts): `1` makes tag deploys run full
# `cdk deploy` (unified deploy) instead of image-only.
CCE_DEPLOY_INFRA=

# [OPTIONAL] `1` keeps the in-dashboard IAM-copilot APPLY write grant across
# deploys (infra/lib/iam-stack.ts); without it a clean deploy drops the
# grant. Default: off (copilot is read/propose-only).
CCE_IAM_COPILOT_WRITE=

# [OPTIONAL] `1` creates the CCE-IamCopilot managed policy as a CDK construct
# (infra/lib/iam-stack.ts; skipped on staging-suffixed deploys). Installs
# that live-attached a copy must keep this off (policy-name conflict).
# Default: off.
CCE_POLICY_IAM_COPILOT=

# [OPTIONAL] `1` creates the CCE-Playground-NonAnthropicInvoke managed policy
# in CDK (same caveats). Default: off.
CCE_POLICY_PLAYGROUND_NONANTHROPIC=

# [OPTIONAL] `1` creates the cost-remediation managed policy in CDK (same
# caveats). Default: off.
CCE_POLICY_COST_REMEDIATION=
