    "PATCH status=done": {
      "request": {
        "header": "X-Paperclip-Run-Id: <failed issue execution run id>",
        "body": {
          "status": "done"
        }
      },
      "status": 409,
      "error": "Issue run ownership conflict"
    },
    "release": {
      "request": {
        "header": "X-Paperclip-Run-Id: <failed issue execution run id>",
        "body": null
      },
      "status": 409,
      "error": "Issue run ownership conflict",
      "persisted": {
        "status": "in_progress",
        "assigneeIsActor": true,
        "executionRunPreserved": false,
        "checkoutRunPreserved": false
      }
    }
