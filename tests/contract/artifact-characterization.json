  "listFilterValidation": {
    "assigneeAgentId=<not a uuid>": {
      "status": 422,
      "error": "assigneeAgentId must be a UUID or 'null'"
    },
    "parentId=<not a uuid>": {
      "status": 500,
      "error": "Internal server error"
    },
    "status=<not a status>": {
      "status": 200,
      "error": null,
      "rows": 0
    }
  },
  "checkoutReleaseContract": {
    "POST /api/issues/{id}/checkout as another agent": {
      "status": 403,
      "error": "Agent can only checkout as itself"
    },
    "POST /api/issues/{id}/release run-less": {
      "status": 401,
      "error": "Agent run id required"
    },
    "POST /api/issues/{id}/release holding a run id": {
      "status": 200,
      "error": null
    },
    "POST /api/issues/{id}/checkout with an unmatched expectedStatuses": {
      "status": 409,
      "error": "Issue checkout conflict"
    },
    "POST /api/issues/{id}/checkout with an empty expectedStatuses": {
      "status": 400,
      "error": "Validation error"
    }
  },
  "wakeupDefaults": {
    "status code on the run branch": 202,
    "status code on the skipped branch": 202,
    "triggerDetail when the request omits it": "manual",
    "reason on a skip whose issueId does not resolve": "wakeup_skipped",
    "status on the run row a fresh wakeup returns": "queued"
  },
  "searchRateLimit": {
    "GET /api/companies/{companyId}/search": {
      "limit": 60,
      "rateLimitHeadersOnSuccess": true,
      "sharedBucketWithExtract": true,
      "drainedAfterSerialRequests": true,
      "refusal": {
        "status": 429,
        "error": "Search rate limit exceeded"
      },
      "retryAfterHeaderMatchesBodyField": true,
      "scopedToActor": "agent"
    },
    "GET /api/companies/{companyId}/search/extract": {
      "requiresContains": {
        "status": 400,
        "error": "contains must be at least 2 characters"
      },
      "rateLimitHeadersOnValidation400": false
    }
  },
  "issueListCoalescer": {
    "GET /api/companies/{companyId}/issues": {
      "identicalConcurrentReads": 64,
      "identicalConcurrentRefusals": 0,
      "distinctConcurrentReads": 24,
      "refusal": {
        "status": 429,
        "error": "Too many concurrent issue-list requests for this actor/client"
      },
      "retryAfterSeconds": 1,
      "requestCacheHeaderOnRefusal": "retry",
      "rateLimitHeadersOnRefusal": false,
      "clearedByHonouringRetryAfter": true
    }
  },
